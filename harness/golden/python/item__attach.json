{
  "command": "item attach",
  "args": [
    "--json",
    "item",
    "attach",
    "REG12345",
    "<ROOT>/fixture/inputs/sample.pdf"
  ],
  "compatibility_class": "Semantic",
  "fixture_state": "local-api-on",
  "fixture_root": "<ROOT>/fixture",
  "exit_code": 0,
  "stdout": "{\n  \"action\": \"item_attach\",\n  \"ok\": true,\n  \"status\": \"success\",\n  \"code\": \"ATTACHED\",\n  \"key\": \"REG12345\",\n  \"path\": \"<ROOT>/fixture/inputs/sample.pdf\",\n  \"result\": \"mock-bridge-ok\"\n}\n",
  "stderr": "",
  "http_calls": [
    {
      "method": "GET",
      "path": "/connector/ping"
    },
    {
      "method": "GET",
      "path": "/api/"
    },
    {
      "method": "POST",
      "path": "/cli-bridge/eval",
      "body": "return 'ping';"
    },
    {
      "method": "POST",
      "path": "/cli-bridge/eval",
      "body": "var item = Zotero.Items.getByLibraryAndKey(1, 'REG12345'); if (!item) { return 'ERROR: item REG12345 not found'; } var att = await Zotero.Attachments.importFromFile({file: '<ROOT>/fixture/inputs/sample.pdf', parentItemID: item.id}); return 'OK: ' + att.key + ' attached to ' + item.getField('title').substring(0,60);"
    }
  ]
}
