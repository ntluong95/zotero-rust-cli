{
  "command": "item update",
  "args": [
    "--json",
    "item",
    "update",
    "REG12345",
    "--field",
    "title=Updated Fixture"
  ],
  "compatibility_class": "Semantic",
  "fixture_state": "local-api-on",
  "fixture_root": "<ROOT>/fixture",
  "exit_code": 0,
  "stdout": "\"mock-bridge-ok\"\n",
  "stderr": "",
  "http_calls": [
    {
      "method": "GET",
      "path": "/connector/ping"
    },
    {
      "method": "GET",
      "path": "/api/"
    },
    {
      "method": "POST",
      "path": "/cli-bridge/eval",
      "body": "return 'ping';"
    },
    {
      "method": "POST",
      "path": "/cli-bridge/eval",
      "body": "var item = Zotero.Items.getByLibraryAndKey(1, 'REG12345'); if (!item) { return 'ERROR: item REG12345 not found'; } item.setField('title', 'Updated Fixture'); await item.saveTx(); return 'OK: updated ' + item.getField('title').substring(0,60);"
    }
  ]
}
