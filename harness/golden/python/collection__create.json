{
  "command": "collection create",
  "args": [
    "--json",
    "collection",
    "create",
    "Fixture Created"
  ],
  "compatibility_class": "Semantic",
  "fixture_state": "local-api-on",
  "fixture_root": "<ROOT>/fixture",
  "exit_code": 0,
  "stdout": "{\n  \"ok\": true,\n  \"data\": \"mock-bridge-ok\",\n  \"error\": null\n}\n",
  "stderr": "",
  "http_calls": [
    {
      "method": "GET",
      "path": "/connector/ping"
    },
    {
      "method": "GET",
      "path": "/api/"
    },
    {
      "method": "POST",
      "path": "/cli-bridge/eval",
      "body": "return 'ping';"
    },
    {
      "method": "POST",
      "path": "/cli-bridge/eval",
      "body": "var col = new Zotero.Collection(); col.name = 'Fixture Created'; col.libraryID = 1; await col.saveTx(); return {key: col.key, id: col.id, name: col.name, libraryID: 1};"
    }
  ]
}
